# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Spreadsheets - the auto-fill columns hold the image-hosting URL, so the
# workbook stays out of the repository.
*.xlsx
*.xlsm

# Remembered folder / spreadsheet choices (machine specific)
photofuse-settings.json

# Points the .bat files at a particular python.exe - specific to one computer
python-path.txt

# Generated output, but keep the folder notes. Both folders are listed
# explicitly: a pattern containing a slash is anchored to this file, so a bare
# "output/*" would miss the one inside PDF CLeaner.
output/*
!output/FINISHED IMAGES APPEAR HERE.txt
PDF CLeaner/output/*
!PDF CLeaner/output/CLEANED PDFS APPEAR HERE.txt

# Raw crops people drop in, but keep the folder note
input/*
!input/PUT RAW CROPS HERE.txt

# Windows
desktop.ini
Thumbs.db
